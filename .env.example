# Public site origin, no trailing path. Example: https://www.example.com
SITE_URL=

# Folder for admin content (products, pages, uploads). In production it must be
# OUTSIDE the Node.js Application root, e.g. /home/<user>/optima-data.
# Empty = ./data (local development only).
DATA_DIR=

# Generate with: npm run admin:hash-password
ADMIN_PASSWORD_HASH=

# Random string, at least 32 characters. Changing it logs the admin out.
SESSION_SECRET=
